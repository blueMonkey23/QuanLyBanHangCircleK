# Copy this file to each service folder as .env
# Common
NODE_ENV=development
AUTH_TOKEN_SECRET=change_me_for_demo
AUTH_TOKEN_TTL_HOURS=12
INTERNAL_API_KEY=circlek-internal-demo-key

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=circlek
DB_SSL=false

# Service ports
USER_SERVICE_PORT=7001
PRODUCT_SERVICE_PORT=7002
ORDER_SERVICE_PORT=7003
REPORT_SERVICE_PORT=7004
GATEWAY_PORT=8000

# Optional service URLs for split-machine demo.
# For VS Code forwarded ports, use the full https://...devtunnels.ms URL.
USER_SERVICE_URL=http://localhost:7001
PRODUCT_SERVICE_URL=http://localhost:7002
ORDER_SERVICE_URL=http://localhost:7003
REPORT_SERVICE_URL=http://localhost:7004
GATEWAY_BASE_URL=http://localhost:8000
OUTBOX_POLL_INTERVAL_MS=5000

# Optional v2 init-db config for database-per-service
USER_DB_HOST=localhost
USER_DB_PORT=3306
USER_DB_USER=root
USER_DB_PASSWORD=your_password
USER_DB_NAME=user_db

PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=3306
PRODUCT_DB_USER=root
PRODUCT_DB_PASSWORD=your_password
PRODUCT_DB_NAME=product_db

ORDER_DB_HOST=localhost
ORDER_DB_PORT=3306
ORDER_DB_USER=root
ORDER_DB_PASSWORD=your_password
ORDER_DB_NAME=order_db

REPORT_DB_HOST=localhost
REPORT_DB_PORT=3306
REPORT_DB_USER=root
REPORT_DB_PASSWORD=your_password
REPORT_DB_NAME=report_db
